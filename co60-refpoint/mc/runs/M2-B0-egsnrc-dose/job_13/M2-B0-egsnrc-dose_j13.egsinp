 DOSE RBOUND MIN= 0
 DOSE RBOUND MAX= 2
 IWATCH= off
 STORE INITIAL RANDOM NUMBERS= no
 IRESUME= first
 OUTPUT OPTIONS= material and dose summary
 STORE DATA ARRAYS= yes
 ELECTRON TRANSPORT= normal
 :stop I/O control:

 :start Monte Carlo inputs:
 NUMBER OF HISTORIES= 80000000
