# TestEm13 transmission check of photon cross sections, production physics (DECISIONS D019)
/control/verbose 1
/run/verbose 1
/testem/phys/addPhysics emstandard_opt4
/process/em/UseGeneralProcess false
/testem/det/setMat G4_WATER
/testem/det/setSize @THICK@ cm
/run/initialize
/random/setSeeds @SEED1@ @SEED2@
/gun/particle gamma
/gun/energy @E@ MeV
/run/printProgress 0
/run/beamOn @N@
